              { Rect: { at: [6, 6.5], w: 12, h: 14, radius: 2 } },
              { Line: { from: [10, 10.5], to: [10, 16.5] } },
              { Line: { from: [14, 10.5], to: [14, 16.5] } },
            ],
            edit: [
              { Line: { from: [5.5, 15.5], to: [15.5, 5.5] } },
              { Line: { from: [8.5, 18.5], to: [18.5, 8.5] } },
              { Line: { from: [15.5, 5.5], to: [18.5, 8.5] } },
              { Line: { from: [5.5, 15.5], to: [4.5, 19.5] } },
              { Line: { from: [4.5, 19.5], to: [8.5, 18.5] } },
            ],
            settings: [
              { Circle: { at: [12, 12], r: 3 } },
              { Circle: { at: [12, 12], r: 7 } },
              { Line: { from: [12, 2.5], to: [12, 5] } },
              { Line: { from: [12, 19], to: [12, 21.5] } },
              { Line: { from: [2.5, 12], to: [5, 12] } },
              { Line: { from: [19, 12], to: [21.5, 12] } },
              { Line: { from: [5.3, 5.3], to: [7.05, 7.05] } },
              { Line: { from: [16.95, 16.95], to: [18.7, 18.7] } },
              { Line: { from: [18.7, 5.3], to: [16.95, 7.05] } },
              { Line: { from: [7.05, 16.95], to: [5.3, 18.7] } },
            ],
            home: [
              { Line: { from: [3, 11.5], to: [12, 4] } },
              { Line: { from: [12, 4], to: [21, 11.5] } },
              { Line: { from: [5.5, 10], to: [5.5, 20] } },
              { Line: { from: [5.5, 20], to: [18.5, 20] } },
              { Line: { from: [18.5, 20], to: [18.5, 10] } },
              { Line: { from: [10, 20], to: [10, 14.5] } },
              { Line: { from: [10, 14.5], to: [14, 14.5] } },
              { Line: { from: [14, 14.5], to: [14, 20] } },
            ],
            mail: [
              { Rect: { at: [3, 5.5], w: 18, h: 13, radius: 2 } },
              { Line: { from: [3.8, 7], to: [12, 13] } },
              { Line: { from: [12, 13], to: [20.2, 7] } },
            ],
            calendar: [
              { Rect: { at: [3.5, 5], w: 17, h: 15.5, radius: 2 } },
              { Line: { from: [3.5, 10], to: [20.5, 10] } },
              { Line: { from: [8, 3], to: [8, 7] } },
              { Line: { from: [16, 3], to: [16, 7] } },
            ],
            user: [
              { Circle: { at: [12, 8], r: 4 } },
              { Rect: { at: [4.5, 14.5], w: 15, h: 8, radius: 4 } },
            ],
          },
          default: [],
        },
      },
    },
  },
}
