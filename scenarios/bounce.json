// Bounce: pull down at the top of the list, then a fast swipe down and up: the fling hits the edge.
[
  ["wait", 500],
  ["swipe", "inboxList", 200, 500], ["wait", 1000],
  ["swipe", "inboxList", -300, 100], ["wait", 300],
  ["swipe", "inboxList", 300, 60], ["wait", 2000],
  ["capture", "bounce_end", 800],
  ["done"]
]
